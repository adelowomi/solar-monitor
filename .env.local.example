# Sunhouse — Solar Dashboard
# Point this at your deployed Cloudflare Worker proxy.
# See README.md for proxy deploy steps.
VITE_API_BASE=https://sunhouse-proxy.YOURNAME.workers.dev/apis

# Optional: auto-login credentials (skips the login screen on every device).
# Your password is MD5-hashed before being sent to the API.
# VITE_ACCOUNT=your_username
# VITE_PASSWORD=your_password
