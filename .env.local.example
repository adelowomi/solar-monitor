# Sunhouse frontend — required env vars.
# Copy this file to .env.local and fill in real values.

# Base URL of your deployed Sunhouse API (no trailing slash).
VITE_SUNHOUSE_API_BASE=https://sunhouseapi.example.com

# The API key set as ApiKey:Secret on the API.
VITE_SUNHOUSE_API_KEY=replace-with-your-api-key
